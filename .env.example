# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git — never commit real passwords.

# ── Live Preview ─────────────────────────────────────────────────────────────
# Public address of the real Enerceon app, opened in a new tab by "Open Live Demo".
# (NEXT_PUBLIC_ = built into the page and visible to visitors — never a secret.)
NEXT_PUBLIC_ENERCEON_APP_URL=http://192.168.100.202:3000/registration

# ── "Talk to us" form → Gmail SMTP (server only, never sent to the browser) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
# 16-character Google App Password (Google Account › Security › App passwords),
# NOT your normal Gmail password. Spaces are ignored.
SMTP_PASS=your-16-character-app-password

# Optional: inbox that receives the requests (default: SMTP_USER)
# CONTACT_TO=sales@enerceon.com
# Optional: time zone of the "Received" time in the e-mail (default: Asia/Karachi)
# CONTACT_TIMEZONE=Asia/Karachi

# Optional, development only: extra host names allowed to open `npm run dev`
# from other devices, comma separated. Your computer's own network addresses and
# all private LAN ranges (192.168.x.x, 10.x.x.x, 172.16–31.x.x) are already allowed.
# ALLOWED_DEV_ORIGINS=my-laptop.local
